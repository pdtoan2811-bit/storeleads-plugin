{
  "mcpServers": {
    "grafana": {
      "command": "${STORELEADS_UVX:-uvx}",
      "args": [
        "mcp-grafana@2.0.1",
        "--enabled-tools",
        "search,datasource,dashboard,folder,navigation,sql",
        "--disable-write",
        "--enable-query"
      ],
      "env": {
        "GRAFANA_URL": "https://storedata.ecvision.ai",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${STORELEADS_GRAFANA_TOKEN}"
      }
    }
  }
}
